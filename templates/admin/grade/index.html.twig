{% extends 'admin/base_admin.html.twig' %}

{% block title %}Calificaciones{% endblock %}

{% block breadcrumb %}Calificaciones{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Lista de Calificaciones</h3>
                <div class="card-tools">
                    <a href="{{ path('app_grade_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Nueva Calificación
                    </a>
                </div>
            </div>
            <div class="card-body table-responsive p-0">
                <table id="gradesTable" class="table table-hover table-striped text-nowrap">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Estudiante</th>
                            <th>Sección</th>
                            <th>Calificación</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for grade in grades %}
                        <tr>
                            <td>{{ grade.id }}</td>
                            <td>{{ grade.student.user.name }}</td>
                            <td>{{ grade.section.name }}</td>
                            <td>{{ grade.grade }}</td>
                            <td>{{ grade.date ? grade.date|date('d/m/Y') : '' }}</td>
                            <td>
                                <a href="{{ path('app_grade_show', {'id': grade.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i> Ver
                                </a>
                                <a href="{{ path('app_grade_edit', {'id': grade.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                {{ include('admin/grade/_delete_form.html.twig') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">No hay calificaciones registradas</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
$(document).ready(function() {
    $('#gradesTable').DataTable({
        "language": {
            "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json"
        },
        dom: 'lBfrtip',
        buttons: [
            {
                extend: 'excelHtml5',
                text: '<i class="fas fa-file-excel"></i> Excel',
                title: 'Calificaciones',
                className: 'btn btn-success btn-sm'
            },
            {
                extend: 'pdfHtml5',
                text: '<i class="fas fa-file-pdf"></i> PDF',
                title: 'Calificaciones',
                className: 'btn btn-danger btn-sm'
            }
        ],
        "pageLength": 10,
        "lengthMenu": [10, 25, 50, 100]
    });
});
</script>
{% endblock %}
