<form method="post" action="{{ path('app_grade_delete', {'id': grade.id}) }}" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta calificación?');" style="display: inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ grade.id) }}">
    <button class="btn btn-danger btn-sm">
        <i class="fas fa-trash"></i> Eliminar
    </button>
</form>
