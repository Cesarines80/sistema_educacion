{% extends 'admin/base_admin.html.twig' %}

{% block title %}Editar Calificación{% endblock %}

{% block breadcrumb %}Editar Calificación{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Editar Calificación</h3>
                <div class="card-tools">
                    <a href="{{ path('app_grade_index') }}" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Volver a la Lista
                    </a>
                    {{ include('admin/grade/_delete_form.html.twig') }}
                </div>
            </div>
            <div class="card-body">
                {{ include('admin/grade/_form.html.twig', {'button_label': 'Actualizar'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
