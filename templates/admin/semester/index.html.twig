{% extends 'admin/base_admin.html.twig' %}

{% block title %}Semestres{% endblock %}

{% block breadcrumb %}Semestres{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Lista de Semestres</h3>
                <div class="card-tools">
                    <a href="{{ path('app_semester_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Nuevo Semestre
                    </a>
                </div>
            </div>
            <div class="card-body table-responsive p-0">
                <table id="semestersTable" class="table table-hover table-striped text-nowrap">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Año</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for semester in semesters %}
                        <tr>
                            <td>{{ semester.id }}</td>
                            <td>{{ semester.name }}</td>
                        <td>{{ semester.year }}</td>
                            <td>
                                <a href="{{ path('app_semester_show', {'id': semester.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i> Ver
                                </a>
                                <a href="{{ path('app_semester_edit', {'id': semester.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                {{ include('admin/semester/_delete_form.html.twig') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center">No hay semestres registrados</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
$(document).ready(function() {
    $('#semestersTable').DataTable({
        "language": {
            "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json"
        },
        dom: 'lBfrtip',
        buttons: [
            {
                extend: 'excelHtml5',
                text: '<i class="fas fa-file-excel"></i> Excel',
                title: 'Semestres',
                className: 'btn btn-success btn-sm'
            },
            {
                extend: 'pdfHtml5',
                text: '<i class="fas fa-file-pdf"></i> PDF',
                title: 'Semestres',
                className: 'btn btn-danger btn-sm'
            }
        ],
        "pageLength": 10,
        "lengthMenu": [10, 25, 50, 100]
    });
});
</script>
{% endblock %}
