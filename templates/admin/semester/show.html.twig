{% extends 'admin/base_admin.html.twig' %}

{% block title %}Semestre: {{ semester.name }}{% endblock %}

{% block breadcrumb %}Semestre: {{ semester.name }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Detalles del Semestre</h3>
                <div class="card-tools">
                    <a href="{{ path('app_semester_index') }}" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Volver a la Lista
                    </a>
                    <a href="{{ path('app_semester_edit', {'id': semester.id}) }}" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">{{ semester.id }}</dd>

                    <dt class="col-sm-3">Nombre</dt>
                    <dd class="col-sm-9">{{ semester.name }}</dd>

                    <dt class="col-sm-3">Fecha de Inicio</dt>
                    <dd class="col-sm-9">{{ semester.startDate ? semester.startDate|date('d/m/Y') : '' }}</dd>

                    <dt class="col-sm-3">Fecha de Fin</dt>
                    <dd class="col-sm-9">{{ semester.endDate ? semester.endDate|date('d/m/Y') : '' }}</dd>

                    <dt class="col-sm-3">Activo</dt>
                    <dd class="col-sm-9">{{ semester.isActive ? 'Sí' : 'No' }}</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
{% endblock %}
