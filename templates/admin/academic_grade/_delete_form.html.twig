<form method="post" action="{{ path('app_academic_grade_delete', {'id': academic_grade.id}) }}" onsubmit="return confirm('¿Está seguro de que desea eliminar este grado académico?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ academic_grade.id) }}">
    <button class="btn btn-danger btn-sm">
        <i class="fas fa-trash"></i> Eliminar
    </button>
</form>
