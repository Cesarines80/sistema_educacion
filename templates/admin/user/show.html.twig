{% extends 'admin/base_admin.html.twig' %}

{% block title %}Usuario{% endblock %}

{% block breadcrumb %}Usuario{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Detalles del Usuario</h3>
                <div class="card-tools">
                    <a href="{{ path('app_user_index') }}" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Volver a la Lista
                    </a>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                    {{ include('admin/user/_delete_form.html.twig') }}
                </div>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">{{ user.id }}</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">{{ user.email }}</dd>

                    <dt class="col-sm-3">Roles</dt>
                    <dd class="col-sm-9">{{ user.roles ? user.roles|join(', ') : '' }}</dd>

                    <dt class="col-sm-3">Nombre</dt>
                    <dd class="col-sm-9">{{ user.name }}</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
{% endblock %}
