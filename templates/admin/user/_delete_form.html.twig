<form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" id="delete-form-{{ user.id }}" style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-danger btn-sm" type="button" onclick="confirmDelete({{ user.id }}, '{{ user.email }}')">
        <i class="fas fa-trash"></i> Eliminar
    </button>
</form>

<script>
function confirmDelete(userId, userEmail) {
    Swal.fire({
        title: '¿Estás seguro?',
        text: `¿Quieres eliminar al usuario "${userEmail}"? Esta acción no se puede deshacer.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('delete-form-' + userId).submit();
        }
    });
}
</script>
