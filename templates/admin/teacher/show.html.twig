{% extends 'admin/base_admin.html.twig' %}

{% block title %}Profesor: {{ teacher.name }}{% endblock %}

{% block breadcrumb %}Profesor: {{ teacher.name }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Detalles del Profesor</h3>
                <div class="card-tools">
                    <a href="{{ path('app_teacher_index') }}" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Volver a la Lista
                    </a>
                    <a href="{{ path('app_teacher_edit', {'id': teacher.id}) }}" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">{{ teacher.id }}</dd>

                    <dt class="col-sm-3">Nombre</dt>
                    <dd class="col-sm-9">{{ teacher.name }}</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">{{ teacher.email }}</dd>

                    <dt class="col-sm-3">Teléfono</dt>
                    <dd class="col-sm-9">{{ teacher.phone }}</dd>

                    <dt class="col-sm-3">Especialidad</dt>
                    <dd class="col-sm-9">{{ teacher.specialty }}</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
{% endblock %}
