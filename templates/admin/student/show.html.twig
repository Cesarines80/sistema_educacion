{% extends 'admin/base_admin.html.twig' %}

{% block title %}Estudiante{% endblock %}

{% block breadcrumb %}Estudiante{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Detalles del Estudiante</h3>
                <div class="card-tools">
                    <a href="{{ path('app_student_index') }}" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Volver a la Lista
                    </a>
                    <a href="{{ path('app_student_edit', {'id': student.id}) }}" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                    {{ include('admin/student/_delete_form.html.twig') }}
                </div>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">{{ student.id }}</dd>

                    <dt class="col-sm-3">Nombre</dt>
                    <dd class="col-sm-9">{{ student.name }}</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">{{ student.email }}</dd>

                    <dt class="col-sm-3">Teléfono</dt>
                    <dd class="col-sm-9">{{ student.phone }}</dd>

                    <dt class="col-sm-3">Fecha de Nacimiento</dt>
                    <dd class="col-sm-9">{{ student.birthDate ? student.birthDate|date('Y-m-d') : '' }}</dd>

                    <dt class="col-sm-3">Grado Académico</dt>
                    <dd class="col-sm-9">{{ student.academicGrade ? student.academicGrade.name : '' }}</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
{% endblock %}
