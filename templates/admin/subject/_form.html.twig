{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">{{ form_label(form.name) }}</label>
        <div class="col-sm-10">
            {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.name) }}
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">{{ form_label(form.credits) }}</label>
        <div class="col-sm-10">
            {{ form_widget(form.credits, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.credits) }}
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">{{ form_label(form.description) }}</label>
        <div class="col-sm-10">
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.description) }}
        </div>
    </div>
    <div class="form-group row">
        <div class="offset-sm-2 col-sm-10">
            <button class="btn btn-primary">{{ button_label|default('Guardar') }}</button>
        </div>
    </div>
{{ form_end(form) }}
