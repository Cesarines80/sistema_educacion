{{ form_start(form) }}
<div class="form-group row">
    <label class="col-sm-2 col-form-label">{{ form_label(form.grade) }}</label>
    <div class="col-sm-10">
        {{ form_widget(form.grade, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.grade) }}
    </div>
</div>
<div class="form-group row">
    <label class="col-sm-2 col-form-label">{{ form_label(form.status) }}</label>
    <div class="col-sm-10">
        {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.status) }}
    </div>
</div>
<div class="form-group row">
    <label class="col-sm-2 col-form-label">{{ form_label(form.student) }}</label>
    <div class="col-sm-10">
        {{ form_widget(form.student, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.student) }}
    </div>
</div>
<div class="form-group row">
    <label class="col-sm-2 col-form-label">{{ form_label(form.semester) }}</label>
    <div class="col-sm-10">
        {{ form_widget(form.semester, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.semester) }}
    </div>
</div>
<div class="form-group row">
    <label class="col-sm-2 col-form-label">{{ form_label(form.subject) }}</label>
    <div class="col-sm-10">
        {{ form_widget(form.subject, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.subject) }}
    </div>
</div>
<div class="form-group row">
    <div class="offset-sm-2 col-sm-10">
        <button class="btn btn-primary">{{ button_label|default('Guardar') }}</button>
    </div>
</div>
{{ form_end(form) }}
