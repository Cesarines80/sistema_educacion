<form method="post" action="{{ path('app_section_delete', {'id': section.id}) }}" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta sección?');" style="display: inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ section.id) }}">
    <button class="btn btn-danger btn-sm">
        <i class="fas fa-trash"></i> Eliminar
    </button>
</form>
