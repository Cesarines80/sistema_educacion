{% extends 'base.html.twig' %}

{% block title %}Semestre: {{ semester.name }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Semestre: {{ semester.name }}</h1>

        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ semester.id }}</td>
                </tr>
                <tr>
                    <th>Nombre</th>
                    <td>{{ semester.name }}</td>
                </tr>
                <tr>
                    <th>Fecha de Inicio</th>
                    <td>{{ semester.startDate ? semester.startDate|date('d/m/Y') : '' }}</td>
                </tr>
                <tr>
                    <th>Fecha de Fin</th>
                    <td>{{ semester.endDate ? semester.endDate|date('d/m/Y') : '' }}</td>
                </tr>
                <tr>
                    <th>Activo</th>
                    <td>{{ semester.isActive ? 'Sí' : 'No' }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a href="{{ path('app_semester_index') }}" class="btn btn-secondary">Volver al listado</a>
            <a href="{{ path('app_semester_edit', {'id': semester.id}) }}" class="btn btn-warning">Editar</a>
        </div>
    </div>
{% endblock %}
