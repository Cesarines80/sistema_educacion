{% extends 'base.html.twig' %}

{% block title %}Materia: {{ subject.name }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Materia: {{ subject.name }}</h1>

        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ subject.id }}</td>
                </tr>
                <tr>
                    <th>Nombre</th>
                    <td>{{ subject.name }}</td>
                </tr>
                <tr>
                    <th>Descripción</th>
                    <td>{{ subject.description }}</td>
                </tr>
                <tr>
                    <th>Créditos</th>
                    <td>{{ subject.credits }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a href="{{ path('app_subject_index') }}" class="btn btn-secondary">Volver al listado</a>
            <a href="{{ path('app_subject_edit', {'id': subject.id}) }}" class="btn btn-warning">Editar</a>
        </div>
    </div>
{% endblock %}
