{{ form_start(form) }}
    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.name) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.capacity) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            {{ form_row(form.subject) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.teacher) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.semester) }}
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary">{{ button_label|default('Guardar') }}</button>
    </div>
{{ form_end(form) }}
