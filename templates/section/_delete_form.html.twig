<form method="post" action="{{ path('app_section_delete', {'id': section.id}) }}" id="delete-form-{{ section.id }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ section.id) }}">
    <button class="btn btn-danger" type="button" onclick="confirmDelete({{ section.id }}, '{{ section.name }}')">Eliminar</button>
</form>

<script>
function confirmDelete(sectionId, sectionName) {
    Swal.fire({
        title: '¿Estás seguro?',
        text: `¿Quieres eliminar la sección "${sectionName}"? Esta acción no se puede deshacer.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('delete-form-' + sectionId).submit();
        }
    });
}
</script>
