{% extends 'base.html.twig' %}

{% block title %}Sección: {{ section.name }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Sección: {{ section.name }}</h1>

        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ section.id }}</td>
                </tr>
                <tr>
                    <th>Nombre</th>
                    <td>{{ section.name }}</td>
                </tr>
                <tr>
                    <th>Capacidad</th>
                    <td>{{ section.capacity }}</td>
                </tr>
                <tr>
                    <th>Materia</th>
                    <td>{{ section.subject.name }}</td>
                </tr>
                <tr>
                    <th>Profesor</th>
                    <td>{{ section.teacher.name }}</td>
                </tr>
                <tr>
                    <th>Semestre</th>
                    <td>{{ section.semester.name }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a href="{{ path('app_section_index') }}" class="btn btn-secondary">Volver al listado</a>
            <a href="{{ path('app_section_edit', {'id': section.id}) }}" class="btn btn-warning">Editar</a>
        </div>
    </div>
{% endblock %}
