{% extends 'base.html.twig' %}

{% block title %}Historial Académico: {{ academic_history.student.name }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Historial Académico: {{ academic_history.student.name }}</h1>

        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ academic_history.id }}</td>
                </tr>
                <tr>
                    <th>Calificación</th>
                    <td>{{ academic_history.grade }}</td>
                </tr>
                <tr>
                    <th>Estado</th>
                    <td>{{ academic_history.status }}</td>
                </tr>
                <tr>
                    <th>Estudiante</th>
                    <td>{{ academic_history.student.name }}</td>
                </tr>
                <tr>
                    <th>Semestre</th>
                    <td>{{ academic_history.semester.name }}</td>
                </tr>
                <tr>
                    <th>Materia</th>
                    <td>{{ academic_history.subject.name }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a href="{{ path('app_academic_history_index') }}" class="btn btn-secondary">Volver al listado</a>
            <a href="{{ path('app_academic_history_edit', {'id': academic_history.id}) }}" class="btn btn-warning">Editar</a>
        </div>
    </div>
{% endblock %}
