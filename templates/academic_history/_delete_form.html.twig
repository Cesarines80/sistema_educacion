<form method="post" action="{{ path('app_academic_history_delete', {'id': academic_history.id}) }}" id="delete-form-{{ academic_history.id }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ academic_history.id) }}">
    <button class="btn btn-danger" type="button" onclick="confirmDelete({{ academic_history.id }}, 'Historial Académico ID {{ academic_history.id }}')">Eliminar</button>
</form>

<script>
function confirmDelete(academicHistoryId, academicHistoryInfo) {
    Swal.fire({
        title: '¿Estás seguro?',
        text: `¿Quieres eliminar el registro de historial académico "${academicHistoryInfo}"? Esta acción no se puede deshacer.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('delete-form-' + academicHistoryId).submit();
        }
    });
}
</script>
