{% extends 'base.html.twig' %}

{% block title %}Profesor: {{ teacher.name }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Profesor: {{ teacher.name }}</h1>

        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ teacher.id }}</td>
                </tr>
                <tr>
                    <th>Nombre</th>
                    <td>{{ teacher.name }}</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>{{ teacher.email }}</td>
                </tr>
                <tr>
                    <th>Teléfono</th>
                    <td>{{ teacher.phone }}</td>
                </tr>
                <tr>
                    <th>Especialidad</th>
                    <td>{{ teacher.specialty }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a href="{{ path('app_teacher_index') }}" class="btn btn-secondary">Volver al listado</a>
            <a href="{{ path('app_teacher_edit', {'id': teacher.id}) }}" class="btn btn-warning">Editar</a>
        </div>
    </div>
{% endblock %}
