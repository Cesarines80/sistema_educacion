{% extends 'base.html.twig' %}

{% block title %}Calificación: {{ grade.value }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Calificación: {{ grade.value }}</h1>

        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ grade.id }}</td>
                </tr>
                <tr>
                    <th>Calificación</th>
                    <td>{{ grade.value }}</td>
                </tr>
                <tr>
                    <th>Estudiante</th>
                    <td>{{ grade.student.name }}</td>
                </tr>
                <tr>
                    <th>Sección</th>
                    <td>{{ grade.section.name }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a href="{{ path('app_grade_index') }}" class="btn btn-secondary">Volver al listado</a>
            <a href="{{ path('app_grade_edit', {'id': grade.id}) }}" class="btn btn-warning">Editar</a>
        </div>
    </div>
{% endblock %}
